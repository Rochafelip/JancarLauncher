<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Galeria de componentes: só no build debug. Abrir com: adb shell am start -n com.rocha.jancarlauncher/.GalleryActivity -->
        <activity
            android:name=".GalleryActivity"
            android:exported="true"
            android:screenOrientation="landscape" />
        <!-- Prévia do Painel com dados falsos: só no build debug (ver DashPreviewActivity). -->
        <activity
            android:name=".DashPreviewActivity"
            android:exported="true"
            android:taskAffinity="com.rocha.jancarlauncher.dashpreview"
            android:screenOrientation="landscape" />
        <!-- Prévia da tela do Carro com estados falsos: só no build debug (ver CarPreviewActivity). -->
        <activity
            android:name=".CarPreviewActivity"
            android:exported="true"
            android:taskAffinity="com.rocha.jancarlauncher.carpreview"
            android:screenOrientation="landscape" />
        <!-- Prévia da faixa sobre o Android Auto: só no build debug (ver OverlayPreviewActivity). -->
        <activity
            android:name=".OverlayPreviewActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Troca o tema da Home por adb: só no build debug (ver ThemeSetActivity). -->
        <activity
            android:name=".ThemeSetActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
    </application>
</manifest>
